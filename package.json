{
  "name": "geezmart",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc -b && cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:smoke": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build --ssr scripts/ssr-smoke.tsx --outDir dist-ssm && node scripts/run-smoke.mjs",
    "deploy": "npm run build && wrangler pages deploy dist",
    "check:sql": "node scripts/check-sql.mjs",
    "db:bundle": "node scripts/build-schema.mjs && node scripts/check-sql.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "framer-motion": "^14.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.147.0"
  }
}
