# GEEZMART — environment configuration
# Copy to .env and fill in your project values.

# Supabase (used by storefront + admin). Both are PUBLIC, publishable-only keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx

# Never put a service-role key in the frontend. Server-side secrets belong in
# your Cloudflare Worker/Pages Functions environment (or .dev.vars locally).
# SUPABASE_SERVICE_ROLE_KEY=keep-this-server-side
